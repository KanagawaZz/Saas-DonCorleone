# Copie para .env (o .env não vai para o git) e troque os valores.
# Lido pelo docker-compose.yml e pelo backend Django (config/settings/base.py).

# --- Evolution API (WhatsApp) ---
# Chave mestra: a mesma é usada pelo container e pelo painel. Gere uma longa e aleatória.
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
EVOLUTION_DB_PASSWORD=troque-por-uma-senha-forte
EVOLUTION_API_URL=http://localhost:8081
# Nome padrão da instância (pode ser trocado na tela WhatsApp do painel)
EVOLUTION_INSTANCE=don-corleone

# --- Site ---
# Endereço público do site: usado no link de acompanhamento enviado no WhatsApp
SITE_PUBLIC_URL=http://localhost:3000
