# Copie para .env.production no servidor e preencha. NUNCA envie o .env.production para o git.
# Para gerar chaves e senhas aleatórias no servidor:  openssl rand -base64 48

# --- Domínios (os dois precisam apontar para o IP do servidor no DNS) ---
# Site do cliente
SITE_DOMAIN=doncorleonepizzas.com.br
# Painel, API, app do entregador e Traccar
SYSTEM_DOMAIN=sistema.doncorleonepizzas.com.br
# E-mail para avisos do certificado HTTPS (Let's Encrypt)
ACME_EMAIL=seu-email@exemplo.com

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# --- Suporte ---
# WhatsApp do suporte (DDD + número): recebe um aviso a cada novo tipo de erro no sistema.
# Em branco = sem aviso (as ocorrências continuam registradas).
SUPPORT_WHATSAPP=

# --- Banco de dados do sistema ---
DB_PASSWORD=troque-por-uma-senha-forte

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
EVOLUTION_DB_PASSWORD=troque-por-uma-senha-forte
EVOLUTION_INSTANCE=don-corleone
